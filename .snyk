# Snyk policy file. Snyk Code (SAST) triage, reviewed 2026-10-03.
# Every entry is a false positive; see the reason on each. Nothing is ignored
# repository-wide.
version: v1.25.0
ignore:
  python/HardcodedNonCryptoSecret:
    - 'stream_daemon/platforms/streaming/kick.py':
        reason: >-
          Flagged strings are the NAMES of environment variables passed as
          secret_name_env/secret_path_env/doppler_secret_env to get_secret();
          the secret values are resolved at runtime from the secrets manager.
        expires: 2027-04-01T00:00:00.000Z
    - 'stream_daemon/platforms/streaming/twitch.py':
        reason: >-
          Flagged strings are environment variable names passed to
          get_secret(), not credential values.
        expires: 2027-04-01T00:00:00.000Z
    - 'stream_daemon/platforms/streaming/youtube.py':
        reason: >-
          Flagged strings are environment variable names passed to
          get_secret(), not credential values.
        expires: 2027-04-01T00:00:00.000Z
    - 'tests/**':
        reason: Obviously fake test fixture values, not real secrets.
        expires: 2027-04-01T00:00:00.000Z
  python/NoHardcodedCredentials/test:
    - 'tests/**':
        reason: Obviously fake test fixture usernames and passwords, not real credentials.
        expires: 2027-04-01T00:00:00.000Z
