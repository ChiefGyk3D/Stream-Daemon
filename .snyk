# Snyk policy. Snyk Code does not honour per-rule `ignore:` entries from this
# file (measured 2026-10-03: findings stayed open with "Ignored issues: 0"), so
# this file only excludes paths from code analysis, and nothing from Snyk Open
# Source. Review by 2027-04-01.
version: v1.25.0
exclude:
  code:
    # Test fixtures: fake usernames and placeholder values assigned to names
    # like password and secret are what tests are made of, and the 52 LOW
    # findings here were all of that kind. The source tree stays scanned.
    - tests/**
